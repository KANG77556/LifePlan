<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_dial_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_horizontal"
 android:background="@drawable/widget_background" android:padding="11dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
   android:text="24시간 생활계획표" android:textStyle="bold" android:textColor="#334563" android:textSize="14sp"
   android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_dial_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="오늘 일정" android:textColor="#5273E8" android:textSize="11sp" android:textStyle="bold"/>
 </LinearLayout>
 <ImageView android:id="@+id/widget_dial_image"
  android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:src="@drawable/lifeplan_icon" android:scaleType="fitCenter" android:adjustViewBounds="true"
  android:contentDescription="0시부터 24시까지 원형 시간표" />
 <TextView android:id="@+id/widget_dial_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="탭하여 오늘 일정 열기" android:gravity="center" android:textSize="11sp"
  android:textColor="#8391AE" android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>