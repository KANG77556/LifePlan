<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_today_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="@drawable/widget_background" android:padding="14dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="라이프플랜 · 오늘" android:textColor="#4E6CE8" android:textStyle="bold" android:textSize="15sp"/>
  <TextView android:id="@+id/widget_today_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="일정 0개" android:textColor="#4E6CE8" android:textStyle="bold" android:textSize="12sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘" android:textColor="#8593AE" android:textSize="11sp" android:layout_marginTop="2dp"/>
 <TextView android:id="@+id/widget_task1" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:text="일정을 불러오세요" android:textColor="#243452" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="10dp"/>
 <TextView android:id="@+id/widget_task2" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#435476" android:textSize="12sp" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_task3" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#435476" android:textSize="12sp" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="일정 보기" android:textColor="#5474EC" android:textStyle="bold" android:textSize="11sp" android:layout_marginTop="6dp"/>
</LinearLayout>